# skos scheduler env file - TEMPLATE. Copy to ~/.skcapstone/skos-schedule.env,
# fill in real values, and chmod 600. That real file is NOT committed to git.
#
#   install -m 600 deploy/schedule/skos-schedule.env.example ~/.skcapstone/skos-schedule.env
#   ${EDITOR:-nano} ~/.skcapstone/skos-schedule.env
#
# `skos schedule install` sources this file to resolve the values for the env var
# names listed under defaults.secret_env in jobs.yaml, and injects them into the
# rendered crontab lines. The values never appear in the repo or in `render`.
#
# gog keyring password that unlocks the 5 Gmail OAuth tokens (used by every gog
# call in the pipeline). Rotate per the secret-rotation task; do not paste the old
# value back into git.
GOG_KEYRING_PASSWORD=replace-me
